48. function prime(num) {
    let sum = 0
    let i = 2;

    while (i <= num) {
        if (num % i === 0) {
            sum += i;
            while (num % i === 0) {
                num = num / i;
            }
        }
        i++;
    }
    return sum;    
}
console.log(prime(12));

49. function secondLargest(arr) {
    arr.sort(function (a, b) {
        return a - b;
    });
    return arr[arr.length - 2];
}
console.log(secondLargest([10, 20, 4, 45, 99]));
